{
  "name": "@towncore/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts | pino-pretty",
    "start": "node dist/main.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "weather:once": "tsx src/weather-once.ts",
    "maps:once": "tsx src/maps-once.ts"
  },
  "dependencies": {
    "@towncore/adapters": "workspace:*",
    "@towncore/config": "workspace:*",
    "@towncore/db": "workspace:*",
    "@towncore/directory": "workspace:*",
    "@towncore/email": "workspace:*",
    "@towncore/mail": "workspace:*",
    "@towncore/pipeline": "workspace:*",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
