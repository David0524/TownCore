# Copy to .env and fill in. Never commit real values (CLAUDE.md rule 11).
# Keep this file in sync with packages/config/src/env.ts (a test enforces it).

# Postgres connection string. Must be a session-mode (non-pooled) URL: pg-boss needs it.
# Local dev: matches docker-compose.yml.
DATABASE_URL=postgres://towncore:towncore@localhost:5432/towncore

# Anthropic API key for the pipeline (production model provider, M3+).
ANTHROPIC_API_KEY=

# Google Gemini API key (free tier; development model provider until Anthropic is set up).
GEMINI_API_KEY=

# Model provider for the pipeline: anthropic or gemini. Unset: anthropic if its key is set, else gemini.
LLM_PROVIDER=

# Stripe secret key and webhook signing secret (M6+).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Domain registrar API key (M7+). Purchases still need --approve-spend.
REGISTRAR_API_KEY=

# Hosting provider API token for attaching domains (M7+).
HOSTING_API_TOKEN=

# Base URL of the staff admin (no trailing slash). /admin is served only on this host; town
# domains never have it. Also used for absolute links in sign-in emails.
APP_BASE_URL=http://localhost:3000

# Comma-separated staff emails allowed to sign in to /admin (M3+).
ADMIN_EMAILS=

# --- Mail platform (docs/plans/MAIL.md) ---

# SES region; must support email receiving. Everything SES-related lives here.
AWS_REGION=us-east-1

# App credentials: send through SES and read/write the mail bucket only (least privilege).
# The onboarding CLI's broader credentials stay in the operator's own shell, never here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 bucket for raw inbound mail and attachments (output of packages/infra).
MAIL_S3_BUCKET=

# How outbound mail leaves: ses, or log (development/CI: printed, never sent). Unset: ses when
# AWS credentials are set, otherwise sending is off.
MAIL_TRANSPORT=

# SES configuration sets for the two sending streams (output of packages/infra).
SES_CONFIG_SET_CONVERSATIONAL=
SES_CONFIG_SET_BULK=

# Comma-separated test domains the owner designated. Onboarding changes DNS on any other
# domain only with --approved (owner sign-off, brief §2.1).
MAIL_TEST_DOMAINS=

# SNS topic ARNs the mail webhook accepts, comma-separated (InboundTopicArn and the two event
# topics from packages/infra). Messages from any other topic are refused.
MAIL_SNS_TOPIC_ARNS=

# Vercel API token with DNS scope, and the team that owns the town domains (onboarding CLI).
VERCEL_DNS_TOKEN=
VERCEL_TEAM_ID=

# Google OAuth client for staff sign-in to /admin; only towncore.net accounts may sign in.
# Once either is set, email-link sign-in is turned off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where DMARC aggregate reports go (rua= in every town's DMARC record).
DMARC_REPORT_ADDRESS=

# Secret for signing unsubscribe and confirmation tokens; at least 32 characters.
MAIL_TOKEN_SECRET=

# Physical postal address printed in newsletter footers (CAN-SPAM).
MAIL_POSTAL_ADDRESS=

# Unsplash API access key (stock photos for evergreen guides, §11c). Worker only; the site
# hotlinks the photos and doesn't need it. Unset: guides keep their title cards.
UNSPLASH_ACCESS_KEY=

# Dev/preview only: force every request to resolve to this town slug (e.g. boca-raton).
DEV_TOWN_SLUG=
