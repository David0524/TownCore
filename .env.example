# Copy to .env and fill in. Never commit real values (CLAUDE.md rule 11).
# Keep this file in sync with packages/config/src/env.ts (a test enforces it).

# Postgres connection string. Must be a session-mode (non-pooled) URL: pg-boss needs it.
# Local dev: matches docker-compose.yml.
DATABASE_URL=postgres://towncore:towncore@localhost:5432/towncore

# The Vercel demo's database (Neon), for pnpm demo:migrate and demo:sync only. Until production runs.
DEMO_DATABASE_URL=
# Neon's direct (unpooled) connection, set on Vercel by the Neon integration: production deploys
# apply migrations through it before building (apps/web vercel-build). Leave empty locally.
DATABASE_URL_UNPOOLED=

# Anthropic API key for the pipeline (production model provider, M3+).
ANTHROPIC_API_KEY=

# Google Gemini API key (free tier; development model provider until Anthropic is set up).
GEMINI_API_KEY=

# Model provider for the pipeline: anthropic or gemini. Unset: anthropic if its key is set, else gemini.
LLM_PROVIDER=
# Network-wide AI spend a day in USD (default 50); set low (e.g. 10) for a first live run.
AI_NETWORK_CAP_USD=

# Stripe secret key and webhook signing secret (M6+).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Development and tests only: built-but-off directory products to show anyway (e.g. "newsletter,exclusive").
DIRECTORY_PRODUCTS_PREVIEW=
# End-to-end tests only: a local fake Stripe API for test keys (the e2e config sets it).
STRIPE_API_BASE=

# Domain registrar: a Vercel token with access to the team in VERCEL_TEAM_ID (D-M7-8). Domain
# search needs no token; buying needs it, plus --approve-spend and a typed confirmation (Rule 10).
REGISTRAR_API_KEY=
# Registrant contact for domain purchases (the owner's, as registered with ICANN). Phone in
# +1.5615550100 form; country as a two-letter code. REGISTRANT_COMPANY is optional.
REGISTRANT_FIRST_NAME=
REGISTRANT_LAST_NAME=
REGISTRANT_EMAIL=
REGISTRANT_PHONE=
REGISTRANT_ADDRESS1=
REGISTRANT_CITY=
REGISTRANT_STATE=
REGISTRANT_ZIP=
REGISTRANT_COUNTRY=US
REGISTRANT_COMPANY=TownCore

# Hosting provider API token for attaching domains (M7+).
HOSTING_API_TOKEN=

# Base URL of the staff admin (no trailing slash). /admin is served only on this host; town
# domains never have it. Also used for absolute links in sign-in emails.
APP_BASE_URL=http://localhost:3000

# Comma-separated staff emails allowed to sign in to /admin (M3+).
ADMIN_EMAILS=

# --- Mail platform (docs/plans/MAIL.md) ---

# SES region; must support email receiving. Everything SES-related lives here.
AWS_REGION=us-east-1

# App credentials: send through SES and read/write the mail bucket only (least privilege).
# The onboarding CLI's broader credentials stay in the operator's own shell, never here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 bucket for raw inbound mail and attachments (output of packages/infra).
MAIL_S3_BUCKET=
# Photos (M9): kept in MAIL_S3_BUCKET under photos/ when AWS is set; otherwise this folder (default .data/photos)
PHOTO_STORAGE_DIR=
# Set by Vercel on its deployments; leave empty locally (photo forms stay closed on Vercel without S3)
VERCEL=
# Set by Vercel: production, preview or development. Only production deploys migrate. Leave empty.
VERCEL_ENV=

# How outbound mail leaves: ses, or log (development/CI: printed, never sent). Unset: ses when
# AWS credentials are set, otherwise sending is off.
MAIL_TRANSPORT=

# SES configuration sets for the two sending streams (output of packages/infra).
SES_CONFIG_SET_CONVERSATIONAL=
SES_CONFIG_SET_BULK=

# Comma-separated test domains the owner designated. Onboarding changes DNS on any other
# domain only with --approved (owner sign-off, brief §2.1).
MAIL_TEST_DOMAINS=

# SNS topic ARNs the mail webhook accepts, comma-separated (InboundTopicArn and the two event
# topics from packages/infra). Messages from any other topic are refused.
MAIL_SNS_TOPIC_ARNS=

# Vercel API token with DNS scope, and the team that owns the town domains (onboarding CLI).
VERCEL_DNS_TOKEN=
VERCEL_TEAM_ID=

# Google OAuth client for staff sign-in to /admin; only towncore.net accounts may sign in.
# Once either is set, email-link sign-in is turned off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where DMARC aggregate reports go (rua= in every town's DMARC record).
DMARC_REPORT_ADDRESS=

# Secret for signing unsubscribe and confirmation tokens; at least 32 characters.
MAIL_TOKEN_SECRET=

# Physical postal address printed in newsletter footers (CAN-SPAM).
MAIL_POSTAL_ADDRESS=

# Unsplash API access key (stock photos for evergreen guides, §11c). Worker only; the site
# hotlinks the photos and doesn't need it. Unset: guides keep their title cards.
UNSPLASH_ACCESS_KEY=

# YouTube Data API v3 key (Google Cloud, API restricted to YouTube Data API v3). Worker only:
# finds town meeting videos to embed on recaps. Unset: YouTube sources are skipped.
YOUTUBE_API_KEY=
# Optional free Socrata app token: raises open-data portals' throttling limits (never required).
SOCRATA_APP_TOKEN=
# Uptime checks (Admin → Analytics): live towns are checked at their own domain. Towns not on their
# domain yet can be checked at a preview address: slug=https://…,slug2=https://…
SITE_CHECK_URLS=
# Census Data API key (free, api.census.gov now requires one): ACS facts for towns by place.
# The ranking and households commands read keyless bulk files from www2.census.gov.
CENSUS_API_KEY=

# Facebook (owner, 2026-10-17). Page access tokens as JSON: {"<page id>": "<token>"}. Used only
# when staff press Post in Admin -> Facebook. Never commit real tokens.
META_PAGE_TOKENS=
# Standing approval for automatic posting: on or off (default off; only the owner turns it on).
FACEBOOK_AUTOPOST=
# Launch cohorts (docs/plans/agentic-ops.md): `worker` advances them in the worker every 5 minutes;
# unset, run `pnpm cohort advance` from a checkout. Buying still needs the cohort's admin approval.
# Owner, 2026-10-17: set to `worker` on the production worker.
COHORT_ORCHESTRATOR=worker
# Secret for hashing poll voters' addresses (16+ characters). Raw addresses are never stored.
VOTE_HASH_SECRET=

# Dev/preview only: force every request to resolve to this town slug (e.g. boca-raton).
DEV_TOWN_SLUG=
