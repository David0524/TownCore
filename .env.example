# Copy to .env and fill in. Never commit real values (CLAUDE.md rule 11).
# Keep this file in sync with packages/config/src/env.ts (a test enforces it).

# Postgres connection string. Must be a session-mode (non-pooled) URL: pg-boss needs it.
# Local dev: matches docker-compose.yml.
DATABASE_URL=postgres://towncore:towncore@localhost:5432/towncore

# Anthropic API key for the pipeline (production model provider, M3+).
ANTHROPIC_API_KEY=

# Google Gemini API key (free tier; development model provider until Anthropic is set up).
GEMINI_API_KEY=

# Model provider for the pipeline: anthropic or gemini. Unset: anthropic if its key is set, else gemini.
LLM_PROVIDER=

# API key for the email provider behind packages/email (M5+).
EMAIL_PROVIDER_KEY=

# Stripe secret key and webhook signing secret (M6+).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare API token, scoped to DNS edit on our zones only (M7+).
CLOUDFLARE_API_TOKEN=

# Domain registrar API key (M7+). Purchases still need --approve-spend.
REGISTRAR_API_KEY=

# Hosting provider API token for attaching domains (M7+).
HOSTING_API_TOKEN=

# Base URL of the app, used for absolute links in emails and admin (no trailing slash).
APP_BASE_URL=http://localhost:3000

# Comma-separated staff emails allowed to sign in to /admin (M3+).
ADMIN_EMAILS=

# Dev/preview only: force every request to resolve to this town slug (e.g. boca-raton).
DEV_TOWN_SLUG=
