{
  "name": "towncore",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "db:generate": "pnpm --filter @towncore/db db:generate",
    "db:check": "pnpm --filter @towncore/db db:check",
    "db:migrate": "pnpm --filter @towncore/db db:migrate",
    "towns:sync": "pnpm --filter @towncore/db towns:sync",
    "sources:status": "pnpm --filter @towncore/adapters sources:status",
    "ingest:once": "pnpm --filter @towncore/adapters ingest:once",
    "evals": "pnpm --filter @towncore/pipeline evals",
    "stories:once": "pnpm --filter @towncore/pipeline stories:once",
    "images:backfill": "pnpm --filter @towncore/pipeline images:backfill",
    "directory:seed": "pnpm --silent --filter @towncore/directory directory:seed",
    "directory:stripe": "pnpm --silent --filter @towncore/directory directory:stripe",
    "mail:routing:sync": "pnpm --filter @towncore/db mail:routing:sync",
    "mail:onboard": "pnpm --silent --filter @towncore/mail onboard",
    "weather:once": "pnpm --filter @towncore/worker weather:once",
    "maps:once": "pnpm --filter @towncore/worker maps:once",
    "mail:import": "pnpm --silent --filter @towncore/mail import",
    "towns:rank": "pnpm --silent --filter @towncore/launcher towns:rank"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
